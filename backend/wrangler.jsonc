{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-faces-catalog",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-25",
  // Workers Free enforces its fixed CPU quota; custom CPU limits require Paid.
  "observability": { "enabled": false },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app-faces",
      "database_id": "d603a056-0722-4bbb-a4d6-83d6cae3ce99",
      "migrations_dir": "migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "UPLOAD_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
